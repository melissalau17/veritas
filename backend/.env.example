# Veritas Backend — Environment Variables
# Copy to .env and fill in your values. Never commit .env.

# Baseten / Muse Spark Open (or any OpenAI-compatible API)
BASETEN_API_KEY=
MODEL_API_KEY=

MODEL_BASE_URL=https://inference.baseten.co/v1
MODEL_NAME=meta-models/muse-spark-open-1026

# Meta SAM 3.1
META_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
SAM_MODEL=sam-3.1

# Flagship Demo Mode (preloads P-101 scenario, ensures deterministic fallback reliability)
DEMO_MODE=true
